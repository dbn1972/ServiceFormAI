NODE_ENV=production
FRONTEND_BIND_PORT=3100
ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

DB_NAME=serviceformai
DB_USERNAME=serviceformai
DB_PASSWORD=replace-with-a-random-hex-secret
REDIS_PASSWORD=replace-with-a-random-hex-secret

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
OTP_PEPPER=replace-with-a-different-random-secret-at-least-32-characters
OTP_PROVIDER_URL=
OTP_PROVIDER_API_KEY=
OTP_FIXED_TEST_ENABLED=false
OTP_FIXED_TEST_MOBILE=
OTP_FIXED_TEST_CODE=123456

KEYCLOAK_PUBLIC_URL=https://identity.example.invalid
KEYCLOAK_ISSUER=https://identity.example.invalid/realms/serviceformai
KEYCLOAK_AUDIENCE=serviceformai-api
KEYCLOAK_CLIENT_ID=serviceformai-web
KEYCLOAK_ADMIN_USERNAME=serviceformai-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-random-secret

AWS_S3_REGION=ap-south-1
AWS_S3_BUCKET=serviceformai-cloudsphere-036215883289-ap-south-1
