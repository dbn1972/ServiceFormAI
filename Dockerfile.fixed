# ServiceFormAI OS - Production Dockerfile
# Multi-stage build for optimized production deployment
# Version: 1.1 - Fixed for non-root nginx

# Build arguments
ARG NODE_VERSION=20
ARG NGINX_VERSION=1.25
ARG PNPM_VERSION=8

# =============================================================================
# Stage 1: Dependencies
# Install all dependencies including dev dependencies for build
# =============================================================================
FROM node:${NODE_VERSION}-alpine AS dependencies

WORKDIR /app

# Install pnpm with caching
RUN npm install -g pnpm@${PNPM_VERSION} && \
    pnpm config set store-dir /root/.pnpm-store

# Copy package files
COPY package.json pnpm-lock.yaml* ./

# Install dependencies with cache mount
RUN --mount=type=cache,target=/root/.pnpm-store \
    pnpm install --frozen-lockfile --prefer-offline

# =============================================================================
# Stage 2: Builder
# Build the application
# =============================================================================
FROM node:${NODE_VERSION}-alpine AS builder

# Build arguments for Vite
ARG VITE_API_URL
ARG VITE_APP_VERSION=1.0.0
ARG NODE_ENV=production

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm@${PNPM_VERSION}

# Copy dependencies from previous stage
COPY --from=dependencies /app/node_modules ./node_modules

# Copy source code
COPY . .

# Set environment variables for build
ENV NODE_ENV=${NODE_ENV}
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_APP_VERSION=${VITE_APP_VERSION}

# Build application
RUN pnpm run build

# =============================================================================
# Stage 3: Production
# Create minimal production image with nginx
# =============================================================================
FROM nginx:${NGINX_VERSION}-alpine AS production

# Build metadata arguments
ARG GIT_COMMIT=unknown
ARG BUILD_DATE

# Install curl for health checks
RUN apk add --no-cache curl

# Create non-root user FIRST
RUN addgroup -g 1001 -S nginx-user && \
    adduser -S -D -H -u 1001 -h /var/cache/nginx -s /sbin/nologin -G nginx-user -g nginx-user nginx-user

# Create temp directories for nginx (required for non-root)
RUN mkdir -p /tmp/nginx_client_body /tmp/nginx_proxy /tmp/nginx_fastcgi /tmp/nginx_uwsgi /tmp/nginx_scgi && \
    mkdir -p /var/cache/nginx/client_temp /var/cache/nginx/proxy_temp && \
    mkdir -p /var/cache/nginx/fastcgi_temp /var/cache/nginx/uwsgi_temp /var/cache/nginx/scgi_temp && \
    chown -R nginx-user:nginx-user /tmp/nginx_* && \
    chown -R nginx-user:nginx-user /var/cache/nginx && \
    chown -R nginx-user:nginx-user /var/log/nginx && \
    touch /tmp/nginx.pid && \
    chown nginx-user:nginx-user /tmp/nginx.pid

# Copy custom nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf
RUN chown nginx-user:nginx-user /etc/nginx/nginx.conf

# Copy built assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html
RUN chown -R nginx-user:nginx-user /usr/share/nginx/html

# Copy health check script
COPY docker-healthcheck.sh /usr/local/bin/healthcheck.sh
RUN chmod +x /usr/local/bin/healthcheck.sh

# Switch to non-root user
USER nginx-user

# Expose port (non-privileged)
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD /usr/local/bin/healthcheck.sh || exit 1

# Labels for metadata
LABEL org.opencontainers.image.title="ServiceFormAI OS" \
      org.opencontainers.image.description="Government service delivery platform" \
      org.opencontainers.image.vendor="ServiceFormAI" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.licenses="Proprietary" \
      org.opencontainers.image.base.name="nginx:1.25-alpine"

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
