# =============================================================================
# ServiceFormAI OS — Environment Configuration Template
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# NEVER commit .env to source control.
# Secrets marked [GENERATE] should be replaced with random secure values:
#   openssl rand -base64 64 | tr -d '\n'
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=production
APP_VERSION=1.0.0
APP_PORT=3000
API_PORT=3001
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Installation metadata (auto-populated by install.sh)
ARCHITECTURE_MODE=small
INSTALLATION_DATE=
DEPLOYMENT_ID=

# -----------------------------------------------------------------------------
# JWT & Session Secrets [GENERATE]
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-generate-with-openssl-rand-base64-64
JWT_REFRESH_SECRET=change-me-generate-with-openssl-rand-base64-64
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
SESSION_SECRET=change-me-generate-with-openssl-rand-base64-64
BOOTSTRAP_SECRET=change-me-only-needed-for-first-admin-bootstrap

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=serviceformai
POSTGRES_USER=serviceformai
POSTGRES_PASSWORD=changeme_in_production      # [GENERATE]
DATABASE_URL=postgresql://serviceformai:changeme_in_production@postgres:5432/serviceformai

# Production HA override (external cluster)
# DATABASE_URL=postgresql://user:pass@your-rds-endpoint:5432/serviceformai?sslmode=require

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_in_production         # [GENERATE]
REDIS_URL=redis://:changeme_in_production@redis:6379/0

# -----------------------------------------------------------------------------
# Object Storage — LocalStack (local dev / CI) or AWS S3 (production)
# -----------------------------------------------------------------------------
#
# LOCAL DEV with LocalStack:
#   Start with: docker-compose up -d localstack
#   Buckets are auto-created by scripts/localstack-init.sh
#
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-south-1

# LocalStack endpoint — set to empty string in production to use real AWS
AWS_S3_ENDPOINT=http://localhost:4566
# Use path-style URLs (required for LocalStack and MinIO)
AWS_S3_FORCE_PATH_STYLE=true

# Document bucket name
AWS_S3_BUCKET=serviceformai-documents
# Asset bucket (logos, white-label)
AWS_S3_ASSETS_BUCKET=serviceformai-assets

# PRODUCTION — comment out AWS_S3_ENDPOINT and set real credentials:
# AWS_ACCESS_KEY_ID=EXAMPLE_AWS_ACCESS_KEY_ID     # [GENERATE - IAM role preferred]
# AWS_SECRET_ACCESS_KEY=EXAMPLE_AWS_SECRET        # [GENERATE - IAM role preferred]
# AWS_S3_ENDPOINT=                                # empty = real AWS
# AWS_S3_FORCE_PATH_STYLE=false

# -----------------------------------------------------------------------------
# Object Storage (MinIO — kept for non-AWS workloads)
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=ap-south-1
S3_BUCKET=serviceformai-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=changeme_in_production          # [GENERATE]
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_in_production    # [GENERATE]

# For AWS S3 or compatible:
# S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# S3_ACCESS_KEY=EXAMPLE_AWS_ACCESS_KEY_ID
# S3_SECRET_KEY=EXAMPLE_AWS_SECRET

# -----------------------------------------------------------------------------
# LocalStack ports (Docker Compose)
# -----------------------------------------------------------------------------
LOCALSTACK_PORT=4566
LOCALSTACK_DEBUG=0

# -----------------------------------------------------------------------------
# MinIO ports (Docker Compose)
# -----------------------------------------------------------------------------
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
ADMINER_PORT=8080

# -----------------------------------------------------------------------------
# Email / SMTP (for password reset, notifications)
# Leave blank to use mock/log-only mode in development.
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@serviceformai.gov.in
SMTP_TLS=true

# -----------------------------------------------------------------------------
# SSO / OAuth Providers
# Leave blank to disable a provider.
# -----------------------------------------------------------------------------
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=${FRONTEND_URL}/auth/callback/google

# Microsoft Azure AD
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_CALLBACK_URL=${FRONTEND_URL}/auth/callback/microsoft

# DigiLocker (India)
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_CALLBACK_URL=${FRONTEND_URL}/auth/callback/digilocker

# -----------------------------------------------------------------------------
# Security Hardening
# -----------------------------------------------------------------------------
ENABLE_CSRF_PROTECTION=true
ENABLE_RATE_LIMITING=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=10
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false            # Set true when HTTPS is enabled
COOKIE_SAMESITE=lax
HELMET_ENABLED=true

# -----------------------------------------------------------------------------
# TLS / HTTPS
# Set TLS_ENABLED=true and provide cert paths when HTTPS is configured.
# -----------------------------------------------------------------------------
TLS_ENABLED=false
TLS_CERT_PATH=
TLS_KEY_PATH=

# -----------------------------------------------------------------------------
# Logging & Monitoring
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_METRICS=false
METRICS_PORT=9090
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Backup & Disaster Recovery
# -----------------------------------------------------------------------------
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *    # Daily at 02:00 UTC
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=serviceformai-backups
BACKUP_ENCRYPTION_KEY=       # [GENERATE] optional at-rest encryption

# -----------------------------------------------------------------------------
# Compliance (DPDP Act 2023, India)
# -----------------------------------------------------------------------------
DPDP_ACT_2023_ENABLED=true
COOKIE_CONSENT_REQUIRED=true
DATA_RETENTION_DAYS=2555      # 7 years default
AUDIT_LOG_RETENTION_DAYS=2555

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_DIGILOCKER=true
ENABLE_AADHAAR_OTP=false      # Requires AUA/KUA license
ENABLE_PAYMENT_GATEWAY=false
ENABLE_AI_FORMS=true
ENABLE_WORKFLOW_ENGINE=true

# -----------------------------------------------------------------------------
# Platform Bootstrap (first-run only)
# Set BOOTSTRAP_SECRET to a strong random value, run bootstrap,
# then UNSET this variable immediately after first admin is created.
# -----------------------------------------------------------------------------
# BOOTSTRAP_SECRET=change-me-and-delete-after-first-use
