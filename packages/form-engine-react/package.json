{
  "name": "@serviceformai/form-engine-react",
  "version": "1.0.0",
  "description": "React bindings for the ServiceFormAI form engine with hooks, context, and pluggable UI adapters",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@serviceformai/form-engine-core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@vitejs/plugin-react": "4.7.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "fast-check": "^3.23.2",
    "jsdom": "^23.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4"
  }
}
