# =============================================================================
# ServiceFormAI Backend — Environment Configuration
# Copy to .env: cp .env.example .env
# =============================================================================

# App
NODE_ENV=development
API_PORT=3001

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=serviceformai
DB_PASSWORD=changeme_in_production
DB_NAME=serviceformai
# IMPORTANT: Keep false in production — use migrations instead
DB_SYNCHRONIZE=false
# Comma-separated trusted reverse-proxy IPs/CIDRs; leave empty when directly exposed
TRUSTED_PROXY_CIDRS=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:changeme_in_production@localhost:6379/0

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-generate-with-openssl-rand-base64-64
JWT_REFRESH_SECRET=change-me-generate-with-openssl-rand-base64-64
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Citizen mobile OTP ───────────────────────────────────────────────────────
OTP_PEPPER=change-me-generate-with-openssl-rand-base64-64
# HTTPS endpoint accepting { "mobile": "+91...", "code": "......" }
OTP_PROVIDER_URL=
OTP_PROVIDER_API_KEY=
# Non-production deterministic code for local E2E only; never set in production
OTP_TEST_CODE=123456

# ── Tenant staff OIDC (Keycloak) ─────────────────────────────────────────────
KEYCLOAK_ISSUER=https://identity.example.gov/realms/serviceformai
KEYCLOAK_AUDIENCE=serviceformai-api
# Set true only during a controlled legacy tenant-password migration window
ALLOW_LEGACY_TENANT_PASSWORD_AUTH=false

# ── AWS S3 / LocalStack ───────────────────────────────────────────────────────
#
# LOCAL DEV: Uses LocalStack (start with docker-compose up -d localstack)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-south-1
AWS_S3_ENDPOINT=http://localhost:4566
AWS_S3_FORCE_PATH_STYLE=true
AWS_S3_BUCKET=serviceformai-documents
AWS_S3_ASSETS_BUCKET=serviceformai-assets
#
# PRODUCTION: Comment out endpoint + force-path-style, use real IAM credentials
# AWS_ACCESS_KEY_ID=EXAMPLE_AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=EXAMPLE_AWS_SECRET
# AWS_S3_ENDPOINT=
# AWS_S3_FORCE_PATH_STYLE=false

# ── Queue ─────────────────────────────────────────────────────────────────────
QUEUE_PROVIDER=database          # 'redis' | 'database' | 'disabled'
QUEUE_WRITE_PATH_ENABLED=true
QUEUE_PAUSED=false

# ── Scalability ───────────────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
